# Place the dataset CSV in ml-service/data/ (or point DATASET_CSV_PATH anywhere).
# All variables are optional; the service reports clearly when something is missing.

# Path to the dataset CSV (absolute, or relative to ml-service/).
DATASET_CSV_PATH=data/reviews.csv

# Column containing the review text.
DATASET_TEXT_COLUMN=

# Column containing the sentiment label (positive/negative/neutral).
DATASET_LABEL_COLUMN=

# Optional: product name column for per-product insights.
DATASET_PRODUCT_COLUMN=

# If the dataset has ratings instead of sentiment labels, set the rating
# column AND opt in with DATASET_RATINGS_ARE_LABELS=true. The mapping
# (rating_to_sentiment in config.py) is explicit — never applied silently.
DATASET_RATING_COLUMN=
DATASET_RATINGS_ARE_LABELS=false

# Service
ML_API_HOST=0.0.0.0
ML_API_PORT=8000
MAX_REVIEW_CHARS=5000
