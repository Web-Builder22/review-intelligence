generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Review {
  id          String   @id @default(uuid()) @db.Uuid
  reviewText  String   @map("review_text")
  sentiment   String?  @map("sentiment")
  confidence  Float?   @map("confidence")
  productName String?  @map("product_name")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("reviews")
  @@index([createdAt])
  @@index([sentiment])
}

model Analysis {
  id            String   @id @default(uuid()) @db.Uuid
  totalReviews  Int      @map("total_reviews")
  positiveCount Int      @default(0) @map("positive_count")
  negativeCount Int      @default(0) @map("negative_count")
  neutralCount  Int      @default(0) @map("neutral_count")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("analyses")
}

model ModelPerformance {
  id        String   @id @default(uuid()) @db.Uuid
  modelName String   @map("model_name")
  accuracy  Float
  precision Float
  recall    Float
  f1Score   Float    @map("f1_score")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("model_performance")
  @@index([modelName])
  @@index([createdAt])
}
