# Backend environment configuration.
# Copy to .env and fill in real values, or have your host inject these.

# Server
PORT=4000
NODE_ENV=development

# Frontend origins allowed by CORS (comma-separated). Use http://localhost:5173 for local Vite dev.
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection string (Supabase). Use the pooled connection (port 6543)
# for serverless-style deployments; use port 5432 for long-lived servers.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Set to "true" to skip strict TLS certificate checks only when required by your provider.
# PGSSL=true
